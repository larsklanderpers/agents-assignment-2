# Copy this file to .env locally. Never commit .env or real credentials.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.5-flash
TIMEZONE=Australia/Sydney

# The supplied OAuth helper reads this fixed location relative to workspace_assistant.
GOOGLE_CREDENTIALS_PATH=config/credentials/credentials.json

# Leave blank while setting up Tasks; add your real token to enable Part 2, then restart ADK.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_USERNAME=larsklanderpers
DEBUG=false
